# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-001
TEMPERATURE=0.2

# Agent settings
MAX_RETRIES=2

# App settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Database
DB_PATH=output/memory.db
FAISS_INDEX_PATH=output/faiss_index
